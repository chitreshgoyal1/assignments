# AWS Bedrock model (Claude via Bedrock — no Anthropic key needed)
BEDROCK_MODEL_ID=anthropic.claude-sonnet-4-5-20250929-v1:0

# AWS
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_SESSION_TOKEN=
AWS_DEFAULT_REGION=us-east-1

# KMS (for credential encryption in sessions)
KMS_KEY_ID=

# DynamoDB
DYNAMODB_TABLE_SESSIONS=zerobug-sessions
DYNAMODB_TABLE_APPROVALS=zerobug-approvals
DYNAMODB_ENDPOINT=

# GitHub / Jira / GitLab credentials are collected from the user at session start
# via the Setup screen and stored encrypted in DynamoDB — do NOT put them here.

# Lambda ARNs (populated after CDK deploy)
RUNTIME_LAMBDA_ARN=
SANDBOX_LAMBDA_ARN=

# API
API_SECRET_KEY=
API_BASE_URL=http://localhost:5173
CORS_ORIGINS=http://localhost:5173

# Approval
APPROVAL_EMAIL=
WEBHOOK_SECRET=

# Frontend (Vite)
VITE_API_BASE_URL=http://localhost:8000
VITE_WS_URL=ws://localhost:8000/ws
